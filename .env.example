TENANT_ID=
CLIENT_ID=
CLIENT_SECRET=
# Active option: Microsoft Dev Tunnel with Graph webhook notifications.
GRAPH_RECEIVE_MODE=webhook
GRAPH_AUTO_SUBSCRIBE=true
# Replace with the HTTPS forwarding URL printed by devtunnel, plus /graph/webhook.
GRAPH_NOTIFICATION_URL=

# Optional offline/local polling fallback (replace active mode settings to enable).
# GRAPH_RECEIVE_MODE=polling
# GRAPH_AUTO_SUBSCRIBE=false
# GRAPH_POLL_INTERVAL_SECONDS=10
# GRAPH_POLL_CHAT_IDS=
GRAPH_CLIENT_STATE=replace-with-a-long-random-secret
GRAPH_SUBSCRIPTION_MINUTES=45
GRAPH_SUBSCRIPTION_FILE=data/subscription.json

# Run python -m scripts.login to fill these two values after Entra device-login setup.
# Development-only delegated token. Production needs a renewing token provider.
# Requires delegated ChatMessage.Send; the user must belong to the target chat.
GRAPH_DELEGATED_ACCESS_TOKEN=
# Object ID of that same signed-in user, required for loop prevention.
GRAPH_SENDER_USER_ID=
# Temporary detailed reply diagnostics. Disable after troubleshooting.
GRAPH_DIAGNOSTICS=false

# Azure OpenAI is called when all three values are configured.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21
